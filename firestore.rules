rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isJaxson() {
      return isSignedIn() && 
             (request.auth.token.email.lower() == 'jaxson@crgia.com' || 
              request.auth.token.email.lower() == 'jaxson.denton05@gmail.com') && 
             isEmailVerified();
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Quote Validation Helper
    function isValidQuote(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'address', 'coverageTypes', 'createdAt', 'status', 'adminContact']) &&
             data.name is string &&
             data.email is string &&
             data.phone is string &&
             data.address is string &&
             data.coverageTypes is list &&
             data.status == 'new' &&
             data.adminContact == 'jaxson@crgia.com';
    }

    match /quotes/{quoteId} {
      // 1. Create - Allow anyone (lead gen) or Jaxson
      allow create: if isValidQuote(incoming()) || isJaxson();
      
      // 2. Read - Only Jaxson
      allow get, list: if isJaxson();
      
      // 3. Update - Only Jaxson can change status
      allow update: if isJaxson() && 
                    (incoming().status in ['new', 'reviewed', 'archived'] || isJaxson());
                      
      // 4. Delete - Only Jaxson
      allow delete: if isJaxson();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
